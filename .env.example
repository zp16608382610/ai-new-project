# ============================================
# Enterprise AI Customer Service Agent
# 复制为 .env 后按需修改:cp .env.example .env
# ============================================

# ---- Application ----
# 运行环境: development / test / production
ENVIRONMENT=development
DEBUG=false
# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---- Backend (FastAPI) ----
APP_NAME=Enterprise AI Customer Service Agent
API_V1_PREFIX=/api/v1
# 仅本地直接运行 uvicorn 时使用
HOST=127.0.0.1
PORT=8000

# ---- Database (SQLAlchemy) ----
# PostgreSQL(默认,与下方 docker-compose 凭据一致)
DATABASE_URL=postgresql+psycopg://acsa:acsa_dev_password@127.0.0.1:5432/acsa
# 无 Docker / 本地测试可临时改用 SQLite:
# DATABASE_URL=sqlite+pysqlite:///./local.db

# ---- PostgreSQL (docker-compose) ----
POSTGRES_USER=acsa
POSTGRES_PASSWORD=acsa_dev_password
POSTGRES_DB=acsa
POSTGRES_PORT=5432

# ---- Redis (docker-compose) ----
REDIS_PORT=6379