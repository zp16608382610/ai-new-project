# Enterprise AI Customer Service Agent - frontend image (Phase 8B).
# Multi-stage: dev/test deps stay in the builder; the runner only keeps the
# production build + production dependencies. BACKEND_INTERNAL_URL is read at
# runtime from the environment (never baked, never NEXT_PUBLIC_*).
FROM node:22-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend ./
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=builder /app/.next ./.next
COPY --from=builder /app/next.config.mjs ./next.config.mjs
COPY --from=builder /app/public ./public

EXPOSE 3000
CMD ["npm", "run", "start"]