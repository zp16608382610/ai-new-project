# Phase 8B production environment template - NO real secrets here.
#
# Usage on the VPS:
#   cp .env.production.example .env.production
#   # fill DEEPSEEK_API_KEY, then either:
#   #   docker compose -f docker-compose.deploy.yml --env-file .env.production ...
#   # or export the variables in the shell before running compose.
# .env.production is ignored by git (see .gitignore).

# --- Database ---
# Demo uses SQLite on the Docker named volume (docs/DEPLOYMENT.md). The deploy
# compose overrides this with the absolute /data path inside the container.
# PostgreSQL remains an architecture-compatible option but is NOT enabled now.
DATABASE_URL=sqlite+pysqlite:///./demo.db

# --- LLM / DeepSeek ---
# Default false => deterministic offline demo, zero API cost even if the key is
# missing. Set true only when you want real DeepSeek answers during the demo.
LLM_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=30

# --- Frontend -> Backend (inside the compose network) ---
# Server-side rewrite target for /api/v1/*. Never expose the backend to the
# public internet; Caddy proxies to the frontend only.
BACKEND_INTERNAL_URL=http://backend:8000